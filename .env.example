# Public site URL, no trailing slash. Leave empty on Vercel until the domain is purchased:
# the site then uses the Vercel production URL automatically.
NEXT_PUBLIC_SITE_URL=

# Resend API key for the join and booking forms. While it is empty the submission is written to
# the server log and the visitor still sees the success message, so nothing is lost.
RESEND_API_KEY=
# Where form submissions are delivered.
CONTACT_TO_EMAIL=Aldhaidvillage.ae@gmail.com
# Sender shown on those emails. The resend.dev address works for testing; a verified domain is
# required before Resend will send to other recipients.
EMAIL_FROM="Al Dhaid Village <onboarding@resend.dev>"
